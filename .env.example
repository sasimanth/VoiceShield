# VoiceShield Environment Configuration

# Project Settings
PROJECT_NAME="VoiceShield"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Backend Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="voiceshield_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/voiceshield_db"

# Security & JWT
JWT_SECRET="super-secret-jwt-key-for-voiceshield-sih-2026-change-in-prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Paths
DEEPFAKE_MODEL_PATH="ml/checkpoints/deepfake_detector_aasist.pt"
SPEAKER_MODEL_PATH="speech/speaker_verification/weights/ecapa_tdnn.pt"

# Risk Engine Thresholds (0.0 to 1.0)
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_MEDIUM=0.60
RISK_THRESHOLD_HIGH=0.80
